{
  "name": "alibar-ui",
  "version": "0.3.0",
  "private": true,
  "description": "alibar/ui: 100 animated, accessible React components for Next.js and Tailwind CSS. Copy, paste, or install with the shadcn CLI.",
  "keywords": [
    "react",
    "nextjs",
    "tailwindcss",
    "motion",
    "animation",
    "components",
    "ui",
    "shadcn",
    "shadcn-registry",
    "accessibility"
  ],
  "homepage": "https://github.com/alibarmonster/alibar-ui#readme",
  "bugs": {
    "url": "https://github.com/alibarmonster/alibar-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alibarmonster/alibar-ui.git"
  },
  "license": "MIT",
  "author": "alibar (https://github.com/alibarmonster)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run registry:build && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "registry:build": "tsx scripts/build-registry.ts && shadcn build",
    "gallery:images": "tsx scripts/generate-gallery-images.ts",
    "check": "tsx scripts/check-components.ts",
    "lab:verify": "tsx scripts/verify-registry.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "geist": "^1.9.0",
    "lucide-react": "^1.65.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
